<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base black background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>
    <!-- Subtle radial blue glow from center -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#20536DFE"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Subtle red glow overlay from bottom -->
    <item
        android:top="300dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#30D32F2F"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
